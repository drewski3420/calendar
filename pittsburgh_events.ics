BEGIN:VEVENT
SUMMARY:Mercury at Greatest Eastern Elongation
DTSTART;VALUE=DATE:20180315
DTEND;VALUE=DATE:20180315
DTSTAMP:20260224T194007Z
UID:9fa46ed6-11b8-11f1-ab09-766b39882e0f
DESCRIPTION:CSVConvert2daaf5d5dbe600c1058261a72d7b80e4\nMarch 15 - Mercury 
 at Greatest Eastern Elongation. The planet Mercury reaches greatest easter
 n elongation of 18.4 degrees from the Sun. This is the best time to view M
 ercury since it will be at its highest point above the horizon in the even
 ing sky. Look for the planet low in the western sky just after sunset.\n\n
 Source: <a href="http://www.seasky.org/astronomy/astronomy-calendar-2018.h
 tml">http://www.seasky.org/astronomy/astronomy-calendar-2018.html</a>
LOCATION:None
END:VEVENT
