BEGIN:VEVENT
SUMMARY:NEAF (Northeast Astronomy Festival)
DTSTART;VALUE=DATE:20160409
DTEND;VALUE=DATE:20160409
DTSTAMP:20260224T194029Z
UID:ad06daaa-11b8-11f1-ab09-766b39882e0f
DESCRIPTION:9jl80cb03ti53lhgocal5nntbo@google.com\nApril 9-10\, 2016\nNorth
 east Astronomy Forum\nSuffern\, New York\nwww.rocklandastronomy.com/neaf.h
