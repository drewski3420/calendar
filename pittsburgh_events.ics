BEGIN:VEVENT
SUMMARY:Mercury at Greatest Eastern Elongation
DTSTART;VALUE=DATE:20181106
DTEND;VALUE=DATE:20181106
DTSTAMP:20260224T194020Z
UID:a7789ccc-11b8-11f1-ab09-766b39882e0f
DESCRIPTION:CSVConvertde981de5f68aca3f0469e594756a2deb\nNovember 6 - Mercur
 y at Greatest Eastern Elongation. The planet Mercury reaches greatest east
 ern elongation of 23.3 degrees from the Sun. This is the best time to view
  Mercury since it will be at its highest point above the horizon in the ev
 ening sky. Look for the planet low in the western sky just after sunset.\n
 \nSource: <a href="http://www.seasky.org/astronomy/astronomy-calendar-2018
 .html">http://www.seasky.org/astronomy/astronomy-calendar-2018.html</a>
LOCATION:None
END:VEVENT
